# Local development configuration placeholders for the Luminary backend.
# Copy to ".env" (or export the variables) and adjust per environment.
# Never commit real secrets to the repository.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/luminary
SPRING_DATASOURCE_USERNAME=luminary
SPRING_DATASOURCE_PASSWORD=change-me
SERVER_PORT=8080

# Sender address for invitation email.
# LUMINARY_MAIL_FROM=Luminary <noreply@luminary.dev>

# SMTP transport. When MAIL_HOST is unset the backend falls back to a
# logging-only mail sender (no real email is transmitted).
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=apikey
# SPRING_MAIL_PASSWORD=secret
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Recommended non-functional SMTP timeout guards (milliseconds):
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=5000
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=5000
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=5000